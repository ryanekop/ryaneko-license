# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
LICENSE_LIST_RPC_ENABLED=false

# Resend Email
RESEND_API_KEY=your_resend_api_key

# License Email Sender
LICENSE_FROM_EMAIL=license@ryanekoapp.web.id
LICENSE_FROM_NAME=Ryan Eko App

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Admin Auth
ADMIN_PASSWORD=replace_with_a_strong_password
# Optional: use a separate long random secret to sign the 12-hour admin session cookie.
# Falls back to ADMIN_PASSWORD when omitted.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Mayar Webhook Secret (optional, for verification)
MAYAR_WEBHOOK_SECRET=your_mayar_secret
MAYAR_API_KEY=your_mayar_api_key
MAYAR_API_BASE_URL=https://api.mayar.id/hl/v1
SUBSCRIPTION_CRON_SECRET=replace_with_a_long_random_secret

# Fastpik Supabase (for unified webhook)
FASTPIK_SUPABASE_URL=your_fastpik_supabase_url
FASTPIK_SUPABASE_SERVICE_KEY=your_fastpik_supabase_service_key
FASTPIK_SITE_URL=https://fastpik.id
FASTPIK_API_URL=https://fastpik.id

# Fastpik Vendor Management (for multi-tenant admin)
NEXT_PUBLIC_FASTPIK_API_URL=https://fastpik.id
FASTPIK_ADMIN_API_KEY=your_fastpik_admin_api_key

# Client Desk Vendor Management (for multi-tenant admin)
CLIENTDESK_SITE_URL=https://clientdesk.id
CLIENTDESK_API_URL=https://clientdesk.id
CLIENTDESK_ADMIN_API_KEY=your_clientdesk_admin_api_key
CLIENTDESK_SUPABASE_URL=your_clientdesk_supabase_url
CLIENTDESK_SUPABASE_SERVICE_KEY=your_clientdesk_supabase_service_key
